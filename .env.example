# LLM (Amazon Bedrock)
MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# 관측 (콜백 추적, README 4.7절)
TRACE_PATH=./logs/trace.jsonl

# 도구 호출 제한 시간(초). 조회 도구는 일시 장애 시 2회까지 재시도, 등록·변경 도구는 재시도하지 않음
TOOL_TIMEOUT=15

# 연도 없는 날짜("11/2 회의 메모")에 붙일 연도. 비우면 실행 시점의 연도
DEFAULT_YEAR=2026

# 경로
DATA_DIR=./data
TASKS_DB=./data/tasks.db
CALENDAR_DB=./data/calendar.db
CHROMA_DIR=./.chroma
CHECKPOINT_DB=./.state/checkpoints.sqlite
MEMORY_DB=./.state/memory.sqlite
